[web]
ec2-web ansible_host=YOUR_EC2_PUBLIC_IP ansible_user=ubuntu ansible_ssh_private_key_file=YOUR_SSH_PRIVATE_KEY_PATH ansible_connection=ssh ansible_python_interpreter=/usr/bin/python3 ansible_ssh_timeout=30 ansible_become=true ansible_become_method=sudo

[web:vars]
ansible_ssh_common_args='-o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ConnectTimeout=30'
